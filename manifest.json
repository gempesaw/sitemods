{
  "manifest_version": 3,
  "name": "sitemods",
  "version": "0.1.0",
  "description": "Personal per-site tweaks.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/pull/*"
      ],
      "js": [
        "sites/github/pr-redirect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "lib/mods.js",
        "sites/github/pr-hide-chrome.js",
        "sites/github/pr-header-links.js",
        "sites/github/one-click-approve.js"
      ],
      "css": [
        "sites/github/github.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
